import tkinter as tk
from tkinter import messagebox

class FibonacciGUI:
    def __init__(self, root):
        self.root = root
        self.root.title("Fibonacci Generator")
        self.root.geometry("400x300")

        # Input label
        tk.Label(root, text="Enter number of terms:", font=("Arial", 12)).pack(pady=10)

        # Input field
        self.entry = tk.Entry(root, font=("Arial", 12))
        self.entry.pack(pady=5)

        # Button
        tk.Button(root, text="Generate", command=self.generate).pack(pady=10)

        # Output label
        self.result = tk.Label(root, text="", font=("Arial", 12), wraplength=350)
        self.result.pack(pady=10)

    def generate(self):
        try:
            n = int(self.entry.get())

            if n <= 0:
                messagebox.showerror("Error", "Enter positive number")
                return

            a, b = 0, 1
            series = []

            for _ in range(n):
                series.append(a)
                a, b = b, a + b

            self.result.config(text=str(series))

        except:
            messagebox.showerror("Error", "Invalid Input")


if __name__ == "__main__":
    root = tk.Tk()
    app = FibonacciGUI(root)
    root.mainloop()
