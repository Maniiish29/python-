import tkinter as tk
from tkinter import messagebox

class ScalableCalculator:
    def __init__(self, root):
        self.root = root
        self.root.title("Nexus Pro Calc")
        
        # Increased initial size for better visibility
        self.root.geometry("400x600") 
        self.root.configure(bg="#121212")

        self.equation = ""

        # Configure Grid Weights so rows and columns expand
        for i in range(4):
            self.root.columnconfigure(i, weight=1)
        for i in range(1, 6):
            self.root.rowconfigure(i, weight=1)

        # Display Screen - using a Label for better auto-scaling text
        self.display_var = tk.StringVar(value="0")
        self.screen = tk.Label(
            root, textvariable=self.display_var, font=("Helvetica", 40),
            bg="#121212", fg="#ffffff", anchor="e", padx=20, pady=40
        )
        self.screen.grid(row=0, column=0, columnspan=4, sticky="nsew")

        buttons = [
            'C', 'DEL', '/', '*',
            '7', '8', '9', '-',
            '4', '5', '6', '+',
            '1', '2', '3', '=',
            '0', '.'
        ]

        row_val = 1
        col_val = 0

        for button in buttons:
            action = lambda x=button: self.on_click(x)
            
            # Styling
            if button == "=":
                btn_color, text_color = "#007acc", "white"
            elif button in ['C', 'DEL', '/', '*', '-', '+']:
                btn_color, text_color = "#1f1f1f", "#007acc"
            else:
                btn_color, text_color = "#2c2c2c", "white"

            btn = tk.Button(
                root, text=button, font=("Helvetica", 18),
                bg=btn_color, fg=text_color, borderwidth=0,
                activebackground="#404040", command=action
            )
            
            # Grid placement logic
            if button == "0":
                btn.grid(row=row_val, column=col_val, columnspan=2, sticky="nsew", padx=2, pady=2)
                col_val += 1
            else:
                btn.grid(row=row_val, column=col_val, sticky="nsew", padx=2, pady=2)

            col_val += 1
            if col_val > 3:
                col_val = 0
                row_val += 1

    def on_click(self, char):
        if char == "=":
            try:
                # Use float for decimals and strip trailing .0 if integer
                result = eval(self.equation)
                self.equation = str(int(result) if result == int(result) else result)
            except:
                messagebox.showerror("Error", "Invalid Format")
                self.equation = ""
        elif char == "C":
            self.equation = ""
        elif char == "DEL":
            self.equation = self.equation[:-1]
        else:
            self.equation += str(char)
        
        self.display_var.set(self.equation if self.equation else "0")

if __name__ == "__main__":
    root = tk.Tk()
    app = ScalableCalculator(root)
    root.mainloop()

