import tkinter as tk
from tkinter import messagebox

class BMICalculator:
    def __init__(self, root):
        self.root = root
        self.root.title("Fitness Analytics")
        self.root.geometry("400x500")
        self.root.configure(bg="#f4f4f9")

        # Header
        tk.Label(root, text="BMI CALCULATOR", font=("Helvetica", 18, "bold"), 
                 bg="#f4f4f9", fg="#333").pack(pady=20)

        # Input Frame
        input_frame = tk.Frame(root, bg="#f4f4f9")
        input_frame.pack(pady=10)

        tk.Label(input_frame, text="Weight (kg):", bg="#f4f4f9").grid(row=0, column=0, sticky="w", pady=5)
        self.weight_entry = tk.Entry(input_frame, font=("Helvetica", 12), width=15)
        self.weight_entry.grid(row=0, column=1, pady=5, padx=10)

        tk.Label(input_frame, text="Height (cm):", bg="#f4f4f9").grid(row=1, column=0, sticky="w", pady=5)
        self.height_entry = tk.Entry(input_frame, font=("Helvetica", 12), width=15)
        self.height_entry.grid(row=1, column=1, pady=5, padx=10)

        # Action Button
        tk.Button(root, text="CALCULATE", command=self.calculate, bg="#2c3e50", 
                  fg="white", font=("Helvetica", 12, "bold"), width=20, pady=5).pack(pady=20)

        # Result Display
        self.result_label = tk.Label(root, text="Result will appear here", font=("Helvetica", 14), 
                                     bg="#f4f4f9", fg="#7f8c8d")
        self.result_label.pack(pady=10)
        
        self.category_label = tk.Label(root, text="", font=("Helvetica", 16, "bold"), bg="#f4f4f9")
        self.category_label.pack()

    def calculate(self):
        try:
            weight = float(self.weight_entry.get())
            height = float(self.height_entry.get()) / 100 # convert to meters
            
            # BMI Formula: weight / height^2
            bmi = round(weight / (height ** 2), 2)
            
            self.result_label.config(text=f"Your BMI: {bmi}", fg="#333")
            
            # Logic for Categories and Colors
            if bmi < 18.5:
                self.category_label.config(text="UNDERWEIGHT", fg="#3498db")
            elif 18.5 <= bmi < 24.9:
                self.category_label.config(text="NORMAL WEIGHT", fg="#2ecc71")
            elif 25 <= bmi < 29.9:
                self.category_label.config(text="OVERWEIGHT", fg="#f1c40f")
            else:
                self.category_label.config(text="OBESE", fg="#e74c3c")
                
        except ValueError:
            messagebox.showerror("Input Error", "Please enter valid numeric values for weight and height.")

if __name__ == "__main__":
    root = tk.Tk()
    app = BMICalculator(root)
    root.mainloop()
